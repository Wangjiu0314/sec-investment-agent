# Copy this file to .env, then fill in your DeepSeek API key.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Common choices: deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required when the pipeline downloads filings from SEC EDGAR.
SEC_USER_AGENT=Your Name your_email@example.com
